<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- Read our Spring property -->
    <springProperty
            scope="context"
            name="elasticsearchUri"
            source="app.elasticsearch.uri"/>

    <!-- Normal console logging -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>

    </appender>


    <!-- Only enabled for Docker and OpenShift -->
    <springProfile name="docker | openshift">

        <appender name="ELASTICSEARCH"
                  class="sopra.steria.demo.logging.ElasticsearchAppender">

            <elasticsearchUri>${elasticsearchUri}</elasticsearchUri>

        </appender>

        <!-- Our application logs go to BOTH destinations -->
        <logger name="sopra.steria.demo"
                level="INFO"
                additivity="false">

            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ELASTICSEARCH"/>

        </logger>

    </springProfile>


    <!-- Everything still goes to the console -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>